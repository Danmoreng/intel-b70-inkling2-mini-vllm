 // ------------------------------------------------------------------------------------------------
 // Routing: one work-group of 1024 work-items (any number of pairs; loops with stride 1024).
+// One lane per routed pair. Rank by (expert, original pair index) without
+// atomics so grouped decoding of up to eight query rows is reproducible.
+static void align_small(sycl::queue &q, const int *ids, const float *weights, int pairs, int topk,
+                        int *experts, int *starts, int *counts, int *active, int *padded_starts, int *tokens,
+                        float *sorted_weights, int *permutation, int *blocks = nullptr,
+                        int *nblocks = nullptr) {
+    q.submit([&](sycl::handler &h) {
+        sycl::local_accessor<int, 1> order(sycl::range<1>(64), h);
+        sycl::local_accessor<int, 1> histogram(sycl::range<1>(64), h);
+        h.parallel_for(sycl::nd_range<1>(64, 64), [=](sycl::nd_item<1> it) {
+            int lane = it.get_local_id(0);
+            int current = lane < pairs ? ids[lane] : 1024;
+            order[lane] = current;
+            sycl::group_barrier(it.get_group());
+            int rank = 0, below = 0, total = 0;
+            for (int j = 0; j < pairs; ++j) {
+                int e = order[j];
+                below += e < current;
+                rank += e == current && j < lane;
+                total += e == current;
+            }
+            sycl::group_barrier(it.get_group());
+            if (lane < pairs) {
+                int index = below + rank;
+                tokens[index] = lane / topk;
+                sorted_weights[index] = weights[lane];
+                permutation[lane] = index;
+                order[index] = current;
+                histogram[index] = rank == 0 ? total : 0;
+            } else
+                histogram[lane] = 0;
+            sycl::group_barrier(it.get_group());
+            int cnt = histogram[lane], has = cnt > 0 ? 1 : 0;
+            int a = sycl::exclusive_scan_over_group(it.get_group(), has, sycl::plus<int>());
+            int n = sycl::reduce_over_group(it.get_group(), has, sycl::plus<int>());
+            if (has) {
+                experts[a] = order[lane];
+                starts[a] = lane;
+                counts[a] = cnt;
+                padded_starts[a] = blocks ? a * 8 : lane;
+                if (blocks)
+                    blocks[a] = a;
+            }
+            if (lane == 0) {
+                active[0] = n;
+                if (nblocks)
+                    nblocks[0] = n;
+            }
+        });
+    });
+}
