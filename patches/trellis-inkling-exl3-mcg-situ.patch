+template <int N>
+ESIMD_INLINE simd<float, N> expert_activation(simd<float, N> gate, simd<float, N> up) {
+#ifdef EXL3_INKLING2
+    const simd<float, N> capped_gate = 4.0f * (2.0f / (1.0f + exp(-gate * 0.5f)) - 1.0f);
+    const simd<float, N> capped_up = 25.0f * (2.0f / (1.0f + exp(-up * 0.08f)) - 1.0f);
+    return capped_gate / (1.0f + exp(-gate)) * capped_up;
+#else
+    return gate / (1.0f + exp(-gate)) * up;
+#endif
+}
+
+static int down_prefill_parts(int hidden) {
+    return hidden == 2304 ? 3 : 4;
+}
