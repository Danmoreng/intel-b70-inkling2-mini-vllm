+    def find_reasoning_end(self, token_ids: Sequence[int]) -> ReasoningEnd:
+        # This is a protocol marker, not part of the JSON payload. An
+        # accepted draft can contain both the marker and first answer tokens.
+        text_id = self.vocab.get(CONTENT_TEXT)
+        for offset, token_id in enumerate(token_ids):
+            if token_id == text_id:
+                return ReasoningEnd(offset, implicit=False)
+        return ReasoningEnd(len(token_ids), implicit=False)
