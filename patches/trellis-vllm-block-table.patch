+// Pack at write time into the VNNI/transpose order consumed by XMX. Each
+// 16-token, one-KV-head tile occupies 4096 bytes inside vLLM's physical page.
+void packed_kv_store(at::Tensor arena, at::Tensor rows, at::Tensor key, at::Tensor value) {
+    TORCH_CHECK(arena.is_xpu() && arena.dim() == 4 && arena.scalar_type() == at::kByte &&
+                arena.size(1) == 8 && arena.size(2) % 16 == 0 && arena.size(3) == 256 &&
+                arena.stride(0) >= arena.size(1) * arena.size(2) * arena.size(3));
+    TORCH_CHECK(rows.device() == arena.device() && rows.scalar_type() == at::kLong && rows.is_contiguous());
+    for (const auto &t: {key,value}) TORCH_CHECK(t.device() == arena.device() && t.scalar_type() == at::kByte &&
+                t.is_contiguous() && t.sizes() == at::IntArrayRef({rows.numel(),8,128}));
+    const int64_t stride = arena.stride(0);
+    const int pg = arena.size(2);
+    const auto *where = rows.data_ptr<int64_t>();
+    auto *dst = arena.data_ptr<uint8_t>();
+    const auto *k = key.data_ptr<uint8_t>(), *v = value.data_ptr<uint8_t>();
+    queue_of(arena).parallel_for(sycl::range<1>(key.numel()),[=](sycl::id<1> id) {
+        const int i=id[0], d=i%128, h=(i/128)%8;
+        const int64_t physical=where[i/1024];
+        if(physical<0) return;
+        const int within=physical%pg, t=within%16;
+        const auto base=(physical/pg)*stride+h*pg*256+(within/16)*4096+(d/16)*256;
+        dst[base+(d%16/4)*64+t*4+d%4]=k[i];
+        dst[base+2048+(t/4)*64+(d%16)*4+t%4]=v[i];
+    });
+}
