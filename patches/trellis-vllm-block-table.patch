+// DSpark global context and the eight jointly visible query-block rows share
+// one contiguous E4M3 cache. The last physical tile is explicitly padded.
+void draft_global_xmx(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor start,
+                      at::Tensor out, at::Tensor lse) {
+    const int splits = out.size(0);
+    TORCH_CHECK(q.is_xpu() && q.scalar_type() == at::kHalf && q.sizes() == at::IntArrayRef({8,24,128}));
+    for (const auto &t: {q,k,v,start,out,lse}) TORCH_CHECK(t.is_contiguous() && t.device() == q.device());
+    TORCH_CHECK(k.scalar_type() == at::ScalarType::Float8_e4m3fn && v.scalar_type() == k.scalar_type() &&
+                k.sizes() == v.sizes() && k.dim() == 3 && k.size(0) % 16 == 0 && k.size(1) == 8 && k.size(2) == 128);
+    TORCH_CHECK(start.scalar_type() == at::kInt && start.numel() == 1 && splits >= 1 &&
+                out.scalar_type() == at::kFloat && lse.scalar_type() == at::kFloat &&
+                out.sizes() == at::IntArrayRef({splits,8,24,128}) && lse.sizes() == at::IntArrayRef({splits,8,24}));
+    fa::PagedXmx<8,false,true> kern{reinterpret_cast<const sycl::half*>(q.data_ptr()),
+        reinterpret_cast<const uint8_t*>(k.data_ptr()), reinterpret_cast<const uint8_t*>(v.data_ptr()),
+        nullptr,nullptr,start.data_ptr<int>(),nullptr,nullptr,out.data_ptr<float>(),lse.data_ptr<float>(),
+        splits,0,0,1024,128,0};
+    queue_of(q).submit([&](sycl::handler& h) {h.parallel_for(sycl::nd_range<1>(splits*24,1),kern);});
+}
