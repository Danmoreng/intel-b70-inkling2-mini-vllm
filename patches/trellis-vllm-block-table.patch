+// Noncausal DSpark block: the K/V cache contains the context and eight
+// freshly projected block rows. Each key split returns a normalized partial.
+void dspark_attention(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor start,
+                      at::Tensor out, at::Tensor lse, int64_t capacity, int64_t window) {
+    TORCH_CHECK(q.is_xpu() && q.scalar_type() == at::kHalf && q.is_contiguous() && q.dim() == 3 &&
+                q.size(0) == 8 && q.size(1) == 24 && q.size(2) == 128);
+    TORCH_CHECK(k.device() == q.device() && v.device() == q.device() && k.scalar_type() == at::kHalf &&
+                v.scalar_type() == at::kHalf && k.is_contiguous() && v.is_contiguous() && k.sizes() == v.sizes() &&
+                k.dim() == 3 && k.size(0) >= 8 && k.size(1) == 8 && k.size(2) == 128);
+    TORCH_CHECK(start.device() == q.device() && start.scalar_type() == at::kInt && start.numel() == 1 &&
+                capacity >= 0 && window >= 0 && ((!capacity && !window) ||
+                (capacity >= window + 8 && k.size(0) == capacity * 2)));
+    TORCH_CHECK(out.device() == q.device() && lse.device() == q.device() && out.scalar_type() == at::kFloat &&
+                lse.scalar_type() == at::kFloat && out.is_contiguous() && lse.is_contiguous() && out.dim() == 4 &&
+                out.size(0) > 0 && out.size(1) == 8 && out.size(2) == 24 && out.size(3) == 128 &&
+                lse.dim() == 3 && lse.size(0) == out.size(0) && lse.size(1) == 8 && lse.size(2) == 24);
+    const int splits = out.size(0);
+    fa::Kern<128, true> kernel{reinterpret_cast<const sycl::half*>(q.data_ptr()),
+        reinterpret_cast<const sycl::half*>(k.data_ptr()), reinterpret_cast<const sycl::half*>(v.data_ptr()),
+        out.data_ptr<float>(), lse.data_ptr<float>(), nullptr, nullptr, 8, int(k.size(0)), 24, 8, 3, 0, 0,
+        0, 0, 1, float(fa::LOG2E / sycl::sqrt(128.0)), start.data_ptr<int32_t>(), splits, int(capacity), int(window)};
+    auto& queue = queue_of(q);
+    queue.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(splits * 24, 3), kernel); });
+}
