+void paged_xmx(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor pages, at::Tensor length,
+               at::Tensor positions, at::Tensor table, at::Tensor sink, at::Tensor out, at::Tensor lse, bool packed) {
+    const int M = q.size(0), splits = out.size(0);
+    TORCH_CHECK(q.is_xpu() && q.is_contiguous() && q.scalar_type() == at::kHalf && q.dim() == 3 &&
+                q.size(1) == 24 && q.size(2) == 128 && (M >= 1 && M <= 8));
+    TORCH_CHECK(k.dim() == 4 && k.size(1) % 16 == 0 && k.size(1) >= 16 && k.size(2) == 8 && k.size(3) == 128 &&
+                k.stride(3) == 1 && k.strides() == v.strides() && k.sizes() == v.sizes() &&
+                k.scalar_type() == at::kFloat8_e4m3fn && v.scalar_type() == k.scalar_type());
+    for (const auto &t: {k,v,pages,length,positions,table,sink,out,lse}) TORCH_CHECK(t.device() == q.device());
+    for (const auto &t: {pages,length,positions,table,sink,out,lse}) TORCH_CHECK(t.is_contiguous());
+    TORCH_CHECK(pages.scalar_type() == at::kInt && pages.dim() == 2 && pages.size(0) == 1 &&
+                length.scalar_type() == at::kInt && length.numel() == 1 && positions.scalar_type() == at::kInt &&
+                positions.numel() == M && table.scalar_type() == at::kFloat && table.dim() == 3 &&
+                table.size(0) == M && table.size(1) == 24 && table.size(2) > 0 &&
+                sink.scalar_type() == at::kFloat && sink.numel() == M*24 && splits > 0 &&
+                out.scalar_type() == at::kFloat && out.numel() == int64_t(splits)*M*24*128 &&
+                lse.scalar_type() == at::kFloat && lse.numel() == int64_t(splits)*M*24);
+    auto& queue = queue_of(q);
+    auto launch = [&]<int Rows>() {
+        fa::PagedXmx<Rows> kern{reinterpret_cast<const sycl::half*>(q.data_ptr()),
+            reinterpret_cast<const uint8_t*>(k.data_ptr()), reinterpret_cast<const uint8_t*>(v.data_ptr()),
+            pages.data_ptr<int>(),length.data_ptr<int>(),positions.data_ptr<int>(),table.data_ptr<float>(),
+            sink.data_ptr<float>(),out.data_ptr<float>(),lse.data_ptr<float>(),
+            splits,int(k.size(1)),int(k.stride(0)),int(k.stride(1)),int(k.stride(2)),int(table.size(2)),packed};
+        const size_t n = splits * 8 * ((Rows*3+7)/8);
+        queue.submit([&](sycl::handler& h) {h.parallel_for(sycl::nd_range<1>(n,1),kern);});
+    };
+    switch (M) {
+        case 1: launch.template operator()<1>(); break;
+        case 2: launch.template operator()<2>(); break;
+        case 3: launch.template operator()<3>(); break;
+        case 4: launch.template operator()<4>(); break;
+        case 5: launch.template operator()<5>(); break;
+        case 6: launch.template operator()<6>(); break;
+        case 7: launch.template operator()<7>(); break;
+        case 8: launch.template operator()<8>(); break;
+    }
+}
