+// Ragged verification: each workgroup attends to rows from exactly one request.
+void batch_xmx(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor pages, at::Tensor lengths,
+               at::Tensor positions, at::Tensor table, at::Tensor sink, at::Tensor offsets, at::Tensor slots,
+               at::Tensor out, at::Tensor lse, bool local, bool packed, int64_t max_rows) {
+    const int rows = q.size(0), requests = slots.numel(), splits = out.size(0);
+    TORCH_CHECK(q.is_xpu() && q.is_contiguous() && q.scalar_type() == at::kHalf &&
+                q.sizes() == at::IntArrayRef({rows, 24, 128}) && requests >= 1 && requests <= 4 &&
+                max_rows >= 1 && max_rows <= 8 && rows >= requests && rows <= requests * max_rows);
+    for (const auto &t : {pages, lengths, positions, offsets, slots})
+        TORCH_CHECK(t.device() == q.device() && t.is_contiguous() && t.scalar_type() == at::kInt);
+    for (const auto &t : {table, sink, out, lse})
+        TORCH_CHECK(t.device() == q.device() && t.is_contiguous() && t.scalar_type() == at::kFloat);
+    TORCH_CHECK(offsets.numel() == requests + 1 && lengths.numel() == requests &&
+                positions.numel() == rows && pages.dim() == 2 && pages.size(1) > 0);
+    TORCH_CHECK(table.dim() == 3 && table.size(0) == rows && table.size(1) == 24 && table.size(2) > 0 &&
+                sink.numel() == rows * 24 && splits > 0 && out.sizes() == at::IntArrayRef({splits,rows,24,128}) &&
+                lse.sizes() == at::IntArrayRef({splits,rows,24}));
+    TORCH_CHECK(k.device() == q.device() && v.device() == q.device() && k.sizes() == v.sizes() &&
+                k.scalar_type() == v.scalar_type() && k.strides() == v.strides() && k.stride(-1) == 1 &&
+                k.size(-1) == 128 && k.size(-2) == 8);
+    if (local) {
+        TORCH_CHECK(!packed && k.dim() == 3 && k.scalar_type() == at::kBFloat16 && k.is_contiguous() &&
+                    pages.size(1) >= 1040 && pages.size(1) % 16 == 0 && pages.numel() == k.size(0));
+    } else {
+        TORCH_CHECK(k.dim() == 4 && k.scalar_type() == at::kFloat8_e4m3fn &&
+                    k.size(1) >= 16 && k.size(1) % 16 == 0 && pages.size(0) == requests);
+    }
+    auto launch = [&]<int MaxRows, bool Local>() {
+        fa::PagedXmx<MaxRows, Local, false, true> kern{
+            reinterpret_cast<const sycl::half *>(q.data_ptr()), reinterpret_cast<const uint8_t *>(k.data_ptr()),
+            reinterpret_cast<const uint8_t *>(v.data_ptr()), pages.data_ptr<int>(), lengths.data_ptr<int>(),
+            positions.data_ptr<int>(), table.data_ptr<float>(), sink.data_ptr<float>(), out.data_ptr<float>(),
+            lse.data_ptr<float>(), splits, int(Local ? pages.size(1) : k.size(1)), int(k.stride(0)),
+            int(k.stride(Local ? 0 : 1)), int(k.stride(Local ? 1 : 2)), int(table.size(2)), packed,
+            offsets.data_ptr<int>(), slots.data_ptr<int>(), rows, int(pages.size(1))};
+        size_t n = requests * splits * 8 * ((MaxRows * 3 + 7) / 8);
+        queue_of(q).submit([&](sycl::handler &h) { h.parallel_for(sycl::nd_range<1>(n, 1), kern); });
+    };
+    if (max_rows <= 2) {
+        if (local) launch.template operator()<2, true>(); else launch.template operator()<2, false>();
+    } else {
+        if (local) launch.template operator()<8, true>(); else launch.template operator()<8, false>();
+    }
+}
