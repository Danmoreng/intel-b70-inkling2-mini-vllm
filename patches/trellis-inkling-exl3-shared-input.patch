+
+// Inkling layers may share the two input-scale vectors across every expert.
+template <typename TIn> struct SharedInputHadamard {
+    const TIn *x;
+    const fp16 *scales;
+    fp16 *result;
+    int hidden;
+    void operator()(sycl::nd_item<1> it) const SYCL_ESIMD_KERNEL {
+        const int blocks = hidden / 128;
+        const int index = it.get_global_id(0);
+        const int token = index / blocks;
+        const int col = (index % blocks) * 128;
+        auto values = convert<float>(block_load<TIn, 128>(x + (size_t)token * hidden + col));
+#pragma unroll
+        for (int proj = 0; proj < 2; ++proj) {
+            auto scale = convert<float>(block_load<fp16, 128>(scales + proj * hidden + col));
+            auto v = convert<float>(convert<fp16>(values * scale));
+            fwht128(v);
+            block_store<fp16, 128>(result + ((size_t)token * 2 + proj) * hidden + col, convert<fp16>(v * kRsqrt128));
+        }
+    }
+};
+
+at::Tensor moe_shared_prefill(at::Tensor x, at::Tensor ids, at::Tensor weights, at::Tensor ptrs, at::Tensor scales) {
+    const int64_t rows = x.size(0), experts = ptrs.numel();
+    TORCH_CHECK(x.is_xpu() && x.is_contiguous() && x.dim() == 2 && x.size(1) == 2304 && rows >= 2048 &&
+                rows <= 1048576 && (x.scalar_type() == at::kHalf || x.scalar_type() == at::kBFloat16));
+    TORCH_CHECK(experts >= 1 && experts <= 1024 && ptrs.dim() == 1 && ptrs.scalar_type() == at::kLong &&
+                ids.sizes() == at::IntArrayRef({rows, 8}) && ids.scalar_type() == at::kInt &&
+                weights.sizes() == ids.sizes() && weights.scalar_type() == at::kFloat &&
+                scales.sizes() == at::IntArrayRef({2, 2304}) && scales.scalar_type() == at::kHalf);
+    for (const auto &t : {ptrs, ids, weights, scales}) {
+        TORCH_CHECK(t.device() == x.device() && t.is_contiguous());
+    }
+    auto inputs = at::empty({rows, 4608}, x.options().dtype(at::kHalf));
+    auto &q = queue_of(x);
+    auto prepare = [&](auto tag) {
+        using TIn = decltype(tag);
+        SharedInputHadamard<TIn> op{reinterpret_cast<const TIn *>(x.data_ptr()),
+                                    reinterpret_cast<const fp16 *>(scales.data_ptr()),
+                                    reinterpret_cast<fp16 *>(inputs.data_ptr()), 2304};
+        size_t items = rows * 18;
+        // Each token contributes exactly eighteen independent 128-value blocks.
+        q.submit([&](sycl::handler &h) { h.parallel_for(sycl::nd_range<1>(items, 2), op); });
+    };
+    if (x.scalar_type() == at::kHalf)
+        prepare(fp16{});
+    else
+        prepare(bf16{});
+    auto out = at::empty_like(x);
+    return moe_prefill<4, false, 64, true>(x, ids, weights, ptrs, Geom{2304, 1152, 4}, experts, out, inputs);
