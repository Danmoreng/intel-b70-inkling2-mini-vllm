+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 0xSero
+// ESIMD attention adapted from sybil-solutions/trellis-serve (MIT), commit 8f8e2fcc.
+#include "common.hpp"
+
+#include <sycl/ext/intel/esimd.hpp>
+#include <sycl/ext/intel/esimd/xmx/dpas.hpp>
+#include <sycl/ext/intel/experimental/esimd/memory.hpp>
+
+namespace inkling_fa {
+using namespace sycl::ext::intel::esimd;
+namespace xesimd = sycl::ext::intel::experimental::esimd;
+using fp16 = sycl::half;
+constexpr int QR = 8, KT = 16, KBT = 2, KB = KT * KBT;
+constexpr float LOG2E = 1.4426950408889634f, NEG = -1e30f;
+
+template <int D>
+struct Kern {
+    const fp16* q; const fp16* k; const fp16* v; float* o;
+    const float * table;
+    const float * sink;
+    const uint16_t * mask;
+    const int32_t * distances;
+    uint32_t table_query_bytes, table_head_bytes, mask_query_bytes, sink_query;
+    int Lq, Lk, Hq, Hk, G, E, QTW;
+    float scale_log2;
+
+    void operator()(sycl::nd_item<1> it) const SYCL_ESIMD_KERNEL {
+        constexpr int NC = D / 16;
+        // work-group = G heads x QTW adjacent query tiles of one kv head (they stream the same keys: L1 sharing)
+        int id = it.get_global_id(0);
+        int g = id % G, t1 = id / G, qti = t1 % QTW, t2 = t1 / QTW, kvh = t2 % Hk, qt = (t2 / Hk) * QTW + qti;
+        int q0 = qt * QR;
+        if (q0 >= Lq) return;
+        int h = kvh * G + g;
+        simd<fp16, NC * QR * 16> Qc = 0;
+#pragma unroll
+        for (int r = 0; r < QR; ++r) {
+            if (q0 + r < Lq) {
+                simd<fp16, D> row = block_load<fp16, D>(q + ((size_t)(q0 + r) * Hq + h) * D);
+#pragma unroll
+                for (int c = 0; c < NC; ++c) Qc.template select<16, 1>((c * QR + r) * 16) = row.template select<16, 1>(c * 16);
+            }
+        }
+        simd<float, NC * QR * 16> O = 0.0f;
+        simd<float, QR> m, l;
+#pragma unroll
+        for (int r = 0; r < QR; ++r) {
+            const bool live = q0 + r < Lq;
+            m[r] = (sink && live) ? sink[(size_t)(q0 + r) * sink_query + h] * LOG2E : NEG;
+            l[r] = (sink && live) ? 1.0f : 0.0f;
+        }
+        const int qpos0 = Lk - Lq;
+        const simd<int, KT> lanes(0, 1);
+        const simd<uint32_t, KT> mask_offsets = simd<uint32_t, KT>(lanes) * 2;
+        const simd<uint32_t, KT> distance_offsets = simd<uint32_t, KT>(lanes) * 4;
+        const uint32_t* kb32 = reinterpret_cast<const uint32_t*>(k + (size_t)kvh * D);
+        const fp16* vbase = v + (size_t)kvh * D;
+        unsigned surfW = D * 2 - 1, surfH = (unsigned)Lk - 1, pitch = (unsigned)Hk * D * 2 - 1;
+        for (int kb0 = 0; kb0 < Lk; kb0 += KB) {
+            bool active = false;
+            for (int r = 0; r < QR && q0 + r < Lq && !active; ++r) {
+                const uint32_t off = uint32_t(q0 + r) * mask_query_bytes + uint32_t(kb0) * 2;
+#pragma unroll
+                for (int t = 0; t < KBT; ++t) {
+                    const simd_mask<KT> valid = (lanes + kb0 + t * KT) < Lk;
+                    simd<uint16_t, KT> bits = gather<uint16_t, KT>(mask, mask_offsets + off + t * KT * 2, valid);
+                    const simd<float, KT> mv = convert<float>(bits.template bit_cast_view<fp16>().read());
+                    active |= (valid & (mv != -INFINITY)).any();
+                }
+            }
+            if (!active) {
+                continue;
+            }
+            simd<float, KBT * QR * KT> S;
+#pragma unroll
+            for (int t = 0; t < KBT; ++t) {
+                simd<float, QR * KT> acc = 0.0f;
+#pragma unroll
+                for (int c = 0; c < NC; ++c) {
+                    simd<uint32_t, 8 * KT> kt = xesimd::lsc_load_2d<uint32_t, 8, KT, 1, true, false,
+                        xesimd::cache_hint::cached, xesimd::cache_hint::cached>(kb32, surfW, surfH, pitch, c * 8, kb0 + t * KT);
+                    acc = xmx::dpas<8, 8, float, float, fp16, fp16>(acc, kt.template bit_cast_view<fp16>().read(),
+                        simd<fp16, QR * 16>(Qc.template select<QR * 16, 1>(c * QR * 16)));
+                }
+                S.template select<QR * KT, 1>(t * QR * KT) = acc * scale_log2;
+            }
+#pragma unroll
+            for (int t = 0; t < KBT; ++t) {
+#pragma unroll
+                for (int r = 0; r < QR; ++r) {
+                    const int row = q0 + r;
+                    const int key0 = kb0 + t * KT;
+                    const simd<int, KT> keys = lanes + key0;
+                    const simd_mask<KT> live = (keys < Lk) & (row < Lq);
+                    const uint32_t mask_off = uint32_t(row) * mask_query_bytes + uint32_t(key0) * 2;
+                    simd<uint16_t, KT> bits = gather<uint16_t, KT>(mask, mask_offsets + mask_off, live);
+                    const simd<float, KT> mv = convert<float>(bits.template bit_cast_view<fp16>().read());
+                    const simd_mask<KT> valid = live & (mv != -INFINITY);
+                    simd<int, KT> delta = (qpos0 + row) - keys;
+                    if (distances) {
+                        const uint32_t off = (uint32_t(row) * uint32_t(Lk) + uint32_t(key0)) * 4;
+                        delta = gather<int32_t, KT>(distances, distance_offsets + off, valid);
+                    }
+                    const simd_mask<KT> near = valid & (delta >= 0) & (delta < E);
+                    const uint32_t bias_off = uint32_t(row) * table_query_bytes + uint32_t(h) * table_head_bytes;
+                    const simd<uint32_t, KT> offsets = simd<uint32_t, KT>(delta) * 4 + bias_off;
+                    const simd<float, KT> bias = gather<float, KT>(table, offsets, near, simd<float, KT>(0));
+                    simd<float, KT> scores = S.template select<KT, 1>((t * QR + r) * KT);
+                    scores += (mv + bias) * LOG2E;
+                    scores.merge(simd<float, KT>(NEG), !valid);
+                    S.template select<KT, 1>((t * QR + r) * KT) = scores;
+                }
+            }
+            simd<float, QR> mb;
+#pragma unroll
+            for (int r = 0; r < QR; ++r) {
+                simd<float, KT> mx = S.template select<KT, 1>(r * KT);
+#pragma unroll
+                for (int t = 1; t < KBT; ++t) mx = max(mx, simd<float, KT>(S.template select<KT, 1>((t * QR + r) * KT)));
+                mb[r] = hmax<float>(mx);
+            }
+            simd<float, QR> m_new = max(m, mb);
+            simd<float, QR> alpha = exp2(m - m_new);
+            simd<float, QR * KT> mrep = m_new.template replicate_vs_w_hs<QR, 1, KT, 0>(0);
+            simd<float, QR> rs = 0.0f;
+            simd<fp16, KBT * QR * KT> P;
+#pragma unroll
+            for (int t = 0; t < KBT; ++t) {
+                simd<float, QR * KT> sp = S.template select<QR * KT, 1>(t * QR * KT);
+                simd<float, QR * KT> p = exp2(sp - mrep);
+                p.merge(simd<float, QR * KT>(0.0f), sp <= NEG * 0.5f);
+#pragma unroll
+                for (int r = 0; r < QR; ++r) rs[r] += reduce<float>(simd<float, KT>(p.template select<KT, 1>(r * KT)), std::plus<>());
+                P.template select<QR * KT, 1>(t * QR * KT) = convert<fp16>(p);
+            }
+            l = l * alpha + rs;
+            m = m_new;
+            simd<float, QR * 16> arep = alpha.template replicate_vs_w_hs<QR, 1, 16, 0>(0);
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+                auto oc = O.template select<QR * 16, 1>(c * QR * 16);
+                simd<float, QR * 16> acc = simd<float, QR * 16>(oc) * arep;
+#pragma unroll
+                for (int t = 0; t < KBT; ++t) {
+                    simd<fp16, KT * 16> vt = xesimd::lsc_load_2d<fp16, 16, KT, 1, false, true,
+                        xesimd::cache_hint::cached, xesimd::cache_hint::cached>(vbase, surfW, surfH, pitch, c * 16, kb0 + t * KT);
+                    acc = xmx::dpas<8, 8, float, float, fp16, fp16>(acc, vt, simd<fp16, QR * 16>(P.template select<QR * KT, 1>(t * QR * KT)));
+                }
+                oc = acc;
+            }
+        }
+        simd<float, QR> inv;
+#pragma unroll
+        for (int r = 0; r < QR; ++r) { float lr = l[r]; inv[r] = lr > 0.f ? 1.0f / lr : 0.f; }
+#pragma unroll
+        for (int r = 0; r < QR; ++r) {
+            if (q0 + r >= Lq) break;
+            simd<float, D> row;
+            const float ir = inv[r];
+#pragma unroll
+            for (int c = 0; c < NC; ++c) row.template select<16, 1>(c * 16) = simd<float, 16>(O.template select<16, 1>((c * QR + r) * 16)) * ir;
+            block_store<float, D>(o + ((size_t)(q0 + r) * Hq + h) * D, row);
+        }
+    }
+};
+}  // namespace inkling_fa
+
+// Inputs match the Q8_0 banded operator. Pack the strided cache into temporary
+// FP16 rows so each ESIMD thread can use 2D hardware loads for its key tiles.
+bool ggml_sycl_inkling_esimd_prefill(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    if (dst->op != GGML_OP_FLASH_ATTN_EXT_BANDED || !ggml_sycl_get_env("GGML_SYCL_INKLING_ESIMD", 0)) {
+        return false;
+    }
+    const auto * q = dst->src[0];
+    const auto * k = dst->src[1];
+    const auto * v = dst->src[2];
+    const auto * mask = dst->src[3];
+    const auto * sink = dst->src[4];
+    const auto * rel = dst->src[6];
+    const auto * distances = dst->src[8];
+    constexpr int D = 128;
+    if (q->ne[0] != D || q->ne[1] < 64 || q->ne[1] > 4096 || q->ne[2] != 24 || q->ne[3] != 1 ||
+        k->ne[1] > 16384 || k->ne[2] != 8 || k->type != GGML_TYPE_Q8_0 || v->type != GGML_TYPE_Q8_0 ||
+        !mask || mask->ne[2] != 1 || !rel || rel->ne[0] != 1024 ||
+        (distances && (!ggml_is_contiguous(distances) || distances->ne[0] != k->ne[1]))) {
+        return false;
+    }
+    const int Lq = q->ne[1], Lk = k->ne[1], Hq = q->ne[2], Hk = k->ne[2];
+    auto stream = ctx.stream();
+    ggml_sycl_pool_alloc<sycl::half> q_half(ctx.pool(), size_t(Lq) * Hq * D);
+    ggml_sycl_pool_alloc<sycl::half> k_half(ctx.pool(), size_t(Lk) * Hk * D);
+    ggml_sycl_pool_alloc<sycl::half> v_half(ctx.pool(), size_t(Lk) * Hk * D);
+
+    const auto * q_data = (const char *) q->data;
+    auto * q_ptr = q_half.get();
+    const size_t q_token = q->nb[1], q_head = q->nb[2];
+    stream->parallel_for(sycl::range<1>(size_t(Lq) * Hq * D), [=](sycl::id<1> id) {
+        const size_t row = id[0] / D;
+        const auto * values = (const float *) (q_data + (row / Hq) * q_token + (row % Hq) * q_head);
+        q_ptr[id[0]] = sycl::half(values[id[0] % D]);
+    });
+
+    const auto pack_cache = [&](const ggml_tensor * src, sycl::half * target) {
+        const auto * data = (const char *) src->data;
+        const size_t token_bytes = src->nb[1], head_bytes = src->nb[2];
+        stream->parallel_for(sycl::range<1>(size_t(Lk) * Hk * D), [=](sycl::id<1> id) {
+            const size_t row = id[0] / D;
+            const auto * blocks = (const block_q8_0 *) (data + (row / Hk) * token_bytes + (row % Hk) * head_bytes);
+            const int index = id[0] % D;
+            const auto & block = blocks[index / QK8_0];
+            target[id[0]] = sycl::half(float(block.d) * block.qs[index % QK8_0]);
+        });
+    };
+    pack_cache(k, k_half.get());
+    pack_cache(v, v_half.get());
+
+    constexpr int QTW = 4;
+    float scale = 0.0f;
+    memcpy(&scale, dst->op_params, sizeof(scale));
+    inkling_fa::Kern<D> kernel{
+        q_ptr, k_half.get(), v_half.get(), (float *) dst->data, (const float *) rel->data,
+        sink ? (const float *) sink->data : nullptr, (const uint16_t *) mask->data,
+        distances ? (const int32_t *) distances->data : nullptr,
+        (uint32_t) rel->nb[2], (uint32_t) rel->nb[1], (uint32_t) mask->nb[1], sink && sink->ne[1] > 1 ? (uint32_t) Hq : 0,
+        Lq, Lk, Hq, Hk, Hq / Hk, (int) rel->ne[0], QTW, scale * inkling_fa::LOG2E,
+    };
+    const int q_tiles = (Lq + inkling_fa::QR - 1) / inkling_fa::QR;
+    const int groups = (q_tiles + QTW - 1) / QTW;
+    stream->parallel_for(sycl::nd_range<1>(size_t(groups) * QTW * Hq, QTW * Hq / Hk), kernel);
+    return true;
+}
