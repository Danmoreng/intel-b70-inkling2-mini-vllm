// SPDX-License-Identifier: MIT
#include <torch/all.h>
#include <torch/library.h>
#include <c10/xpu/XPUStream.h>
#include <sycl/sycl.hpp>
#include <limits>

namespace {
// Prompt history belongs to earlier turns. Only an unfinished final span can
// contribute to this request's initial state.
struct Counter {
    int used;
    bool thinking;

    void accept(int token, int start, int end, int eos) {
        if (token == start) thinking = true;
        else if (token == end || token == eos) thinking = false;
        else if (thinking) ++used;
    }
};

void thinking_budget(at::Tensor logits, const at::Tensor& history, const at::Tensor& total_len,
                     const at::Tensor& input_ids, at::Tensor state, int64_t slot, int64_t prompt,
                     int64_t limit, int64_t start, int64_t end, int64_t eos) {
    TORCH_CHECK(logits.is_xpu() && logits.dim() == 2 && logits.stride(1) == 1 && logits.scalar_type() == at::kFloat);
    for (const auto* tensor : {&history, &total_len, &input_ids})
        TORCH_CHECK(tensor->device() == logits.device() && tensor->scalar_type() == at::kInt && tensor->is_contiguous());
    TORCH_CHECK(state.device() == logits.device() && state.scalar_type() == at::kInt && state.is_contiguous());
    TORCH_CHECK(state.dim() == 2 && state.size(1) == 3 && history.dim() == 2 && slot >= 0 &&
                slot < history.size(0) && slot < state.size(0) && slot < total_len.numel());
    TORCH_CHECK(start >= 0 && end >= 0 && start != end && start < logits.size(1) && end < logits.size(1));
    TORCH_CHECK(eos >= 0 && eos < logits.size(1) && eos != start);
    TORCH_CHECK(prompt >= 0 && prompt <= history.size(1) && limit >= 0 && input_ids.numel() == logits.size(0));
    auto* scores = logits.data_ptr<float>();
    const int* tokens = history.data_ptr<int>() + slot * history.stride(0);
    const int* length = total_len.data_ptr<int>() + slot;
    const int* draft = input_ids.data_ptr<int>();
    int* cache = state.data_ptr<int>() + 3 * slot;
    const int rows = logits.size(0), stride = logits.stride(0);
    auto& queue = c10::xpu::getCurrentXPUStream(logits.device().index()).queue();
    queue.single_task([=]() {
        const int n = *length;
        int pos = cache[0];
        Counter count{cache[1], cache[2] != 0};
        if (pos < prompt || pos > n || pos < 0) {
            pos = prompt;
            count = {0, false};
            for (int i = prompt - 1; i >= 0; --i) {
                if (tokens[i] == end || tokens[i] == eos) break;
                if (tokens[i] == start) {
                    count = {int(prompt - i - 1), true};
                    break;
                }
            }
        }
        for (; pos < n; ++pos) count.accept(tokens[pos], start, end, eos);
        cache[0] = n;
        cache[1] = count.used;
        cache[2] = count.thinking;
        // The first input is the committed anchor. Later rows are tentative
        // proposals and only affect the distribution for their own prefix.
        for (int r = 0; r < rows; ++r) {
            if (r) count.accept(draft[r], start, end, eos);
            if (count.used >= limit) {
                scores[r * stride + start] = -std::numeric_limits<float>::infinity();
                if (count.thinking) scores[r * stride + end] = 1.0e9f;
            }
        }
    });
}
}
TORCH_LIBRARY_FRAGMENT(inkling2_xpu, m) {
    m.def("thinking_budget(Tensor(a!) logits, Tensor history, Tensor total_len, Tensor input_ids, "
          "Tensor(b!) state, int slot, int prompt, int limit, int start, int end, int eos) -> ()", thinking_budget);
}
