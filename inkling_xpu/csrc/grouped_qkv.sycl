// Group-32 INT8 weights. Two signed INT8 activation components preserve FP32 projection accuracy.
#include <torch/all.h>
#include <torch/library.h>
#include <c10/xpu/XPUStream.h>
#include <sycl/sycl.hpp>
#include <sycl/ext/intel/esimd.hpp>
#include <sycl/ext/intel/esimd/xmx/dpas.hpp>
namespace {
namespace es = sycl::ext::intel::esimd;
using i8 = int8_t;

template <int M, bool Accurate>
static void project(sycl::queue &q, const float *xq, const float *xk, const float *xv, const i8 *qw,
                    const sycl::half *sc, i8 *qa, float *as, float *temp, float *out, int rows, int k, int n,
                    int first_k, int first_v, int splits) {
    int groups = k / 32, nt = (n + 15) / 16;
    q.parallel_for(sycl::range<1>(3 * groups), [=](sycl::id<1> id) SYCL_ESIMD_KERNEL {
        using namespace es;
        int ag = id[0], g = ag % groups, which = ag / groups;
        const float *x = which == 0 ? xq : which == 1 ? xk : xv;
#pragma unroll
        for (int row = 0; row < M; ++row) {
            simd<float, 32> v = 0;
            if (row < rows)
                v = block_load<float, 32>(x + row * k + g * 32);
            float scale = hmax<float>(abs(v)) / 127.f;
            if (scale < 1.e-15f)
                scale = 1.e-15f;
            as[ag * M + row] = scale;
            v /= scale;
            simd<i8, 32> hi = convert<i8>(rnde<float>(v));
            block_store<i8, 32>(qa + ((ag * (Accurate ? 2 : 1)) * M + row) * 32, hi);
            if constexpr (Accurate) {
                simd<i8, 32> lo = convert<i8>(rnde<float>((v - convert<float>(hi)) * 128.f));
                block_store<i8, 32>(qa + ((ag * 2 + 1) * M + row) * 32, lo);
            }
        }
    });
    q.parallel_for(sycl::range<1>(nt * splits), [=](sycl::id<1> id) SYCL_ESIMD_KERNEL {
        using namespace es;
        int tile = id[0] % nt, part = id[0] / nt;
        int which = tile * 16 < first_k ? 0 : tile * 16 < first_v ? 1 : 2;
        simd<float, M * 16> sum = 0.f;
        int len = (groups + splits - 1) / splits, first = part * len,
            end = (first + len < groups ? first + len : groups);
        for (int g = first; g < end; ++g) {
            int ag = which * groups + g;
            auto a = block_load<i8, M * 32>(qa + (ag * (Accurate ? 2 : 1)) * M * 32);
            auto b = block_load<i8, 512>(qw + (tile * groups + g) * 512);
            simd<int, M * 16> z = 0;
            auto d = xmx::dpas<8, M, int, int, i8, i8>(z, b, a);
            simd<float, M * 16> dot = convert<float>(d);
            if constexpr (Accurate) {
                auto lo = block_load<i8, M * 32>(qa + (ag * 2 + 1) * M * 32);
                dot += convert<float>(xmx::dpas<8, M, int, int, i8, i8>(z, b, lo)) * (1.f / 128.f);
            }
            auto bs = convert<float>(block_load<sycl::half, 16>(sc + (tile * groups + g) * 16));
#pragma unroll
            for (int row = 0; row < M; ++row)
                sum.template select<16, 1>(row * 16) +=
                    simd<float, 16>(dot.template select<16, 1>(row * 16)) * bs * as[ag * M + row];
        }
#pragma unroll
        for (int row = 0; row < M; ++row)
            if (row < rows) {
                simd<float, 16> v = sum.template select<16, 1>(row * 16);
                if (splits > 1)
                    block_store<float, 16>(temp + ((part * rows + row) * nt + tile) * 16, v);
                else if (tile * 16 + 15 < n)
                    block_store<float, 16>(out + row * n + tile * 16, v);
                else
                    for (int lane = 0; lane < n - tile * 16; ++lane)
                        out[row * n + tile * 16 + lane] = v[lane];
            }
    });
    if (splits > 1)
        q.parallel_for(sycl::range<1>(rows * n), [=](sycl::id<1> id) {
            int flat = id[0], row = flat / n, col = flat % n;
            float v = 0;
            for (int i = 0; i < splits; ++i)
                v += temp[(i * rows + row) * nt * 16 + col];
            out[flat] = v;
        });
}
at::Tensor dense(at::Tensor x, at::Tensor xk, at::Tensor xv, at::Tensor w, at::Tensor s, int64_t n,
                 int64_t first_k, int64_t first_v, int64_t splits, bool accurate) {
    int rows = x.size(0), k = x.size(1),
        m = rows == 1   ? 1
            : rows <= 2 ? 2
            : rows <= 4 ? 4
                        : 8,
        nt = (n + 15) / 16;
    TORCH_CHECK(x.is_xpu() && x.is_contiguous() && x.scalar_type() == at::kFloat && rows > 0 && rows <= 8 &&
                k % 32 == 0 && n > 0 && splits > 0 && splits <= 32 && w.device() == x.device() &&
                s.device() == x.device() && w.is_contiguous() && s.is_contiguous() &&
                w.scalar_type() == at::kChar && s.scalar_type() == at::kHalf &&
                w.numel() == int64_t(nt) * 16 * k && s.numel() == w.numel() / 32);
    for (const auto &t : {xk, xv})
        TORCH_CHECK(t.device() == x.device() && t.sizes() == x.sizes() && t.scalar_type() == at::kFloat &&
                    t.is_contiguous());
    TORCH_CHECK(first_k > 0 && first_k % 16 == 0 && first_v > first_k && first_v % 16 == 0 && n > first_v &&
                n % 16 == 0);
    auto qa = at::empty({3 * int64_t(k) * m * (accurate ? 2 : 1)}, x.options().dtype(at::kChar));
    auto as = at::empty({3 * k / 32, m}, x.options());
    auto temp = at::empty({splits > 1 ? splits * rows * nt * 16 : 0}, x.options()),
         out = at::empty({rows, n}, x.options());
    auto &q = c10::xpu::getCurrentXPUStream(x.device().index()).queue();
#define CALL(M, A)                                                                                           \
    project<M, A>(q, x.data_ptr<float>(), xk.data_ptr<float>(), xv.data_ptr<float>(), w.data_ptr<i8>(),      \
                  reinterpret_cast<const sycl::half *>(s.data_ptr()), qa.data_ptr<i8>(),                     \
                  as.data_ptr<float>(), temp.data_ptr<float>(), out.data_ptr<float>(), rows, k, n, first_k,  \
                  first_v, splits)
#define DISPATCH(M)                                                                                          \
    if (accurate) {                                                                                          \
        CALL(M, true);                                                                                       \
    } else {                                                                                                 \
        CALL(M, false);                                                                                      \
    }
    switch (m) {
    case 1:
        DISPATCH(1);
        break;
    case 2:
        DISPATCH(2);
        break;
    case 4:
        DISPATCH(4);
        break;
    default:
        DISPATCH(8);
    }
    return out;
}
} // namespace
TORCH_LIBRARY(inkling_qkv, m) {
    m.def("dense(Tensor q, Tensor k, Tensor v, Tensor packed, Tensor scales, int columns, int k_offset, int "
          "v_offset, int splits, bool accurate) -> Tensor",
          &dense);
}
